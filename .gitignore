# raw source PDFs — not needed at runtime, large, and copyrighted (IEC standards)
Standards-Reference/
*.pdf
*.zip

# OCR'd full text of the standards — near-verbatim copyrighted IEC text, and NOT
# needed at runtime (the app navigates the wiki/, not corpus/). Kept local only.
kg-app/backend/corpus/

# derived data layer — graph.json / kg.sqlite are regenerated at startup by
# build_kg.py; history.jsonl is kept so the demo runs show for the partner online.
kg-app/backend/data/*
!kg-app/backend/data/history.jsonl

# python / os / misc
__pycache__/
*.pyc
.DS_Store
*.log
.env
.venv/
.playwright-mcp/
